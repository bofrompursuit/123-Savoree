# Copy this file to .env.local and fill in your real values.
# .env.local is already gitignored — never commit real keys.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# From Supabase project settings -> API. Both are safe to expose to the
# browser (NEXT_PUBLIC_) — the anon key only has whatever access your Row
# Level Security policies grant it. See README.md for the "signups" table SQL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
